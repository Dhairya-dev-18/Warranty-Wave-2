# Copy to .env for Docker Compose. Choose a new strong password for each environment.
MYSQL_DATABASE=warrantywave
MYSQL_USER=warrantywave_app
MYSQL_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-long-random-root-password
JWT_SECRET=replace-with-at-least-32-random-characters
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
